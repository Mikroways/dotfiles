export PATH="$HOME/bin:$HOME/.mikroways/bin:$PATH"

# -----------------------------------------------------------------------------
# Mikroways tools
# -----------------------------------------------------------------------------
# Enable mw vpn connect
export MW_VPN_ROOT="$HOME/.mikroways/tools/mw-vpn"
[[ -x $MW_VPN_ROOT/bin/mw-vpn ]] && export PATH="$MW_VPN_ROOT/bin:$PATH" && \
  fpath=($MW_VPN_ROOT/shell-completion/zsh $fpath)

# Enable mw create project
export MW_CREATE_PROJECT_ROOT="$HOME/.mikroways/tools/mw-create-project"
[[ -x $MW_CREATE_PROJECT_ROOT/bin/mw-create-project ]] && export PATH="$MW_CREATE_PROJECT_ROOT/bin:$PATH" && \
  fpath=($MW_CREATE_PROJECT_ROOT/shell-completion/zsh $fpath)

# Enable mw k8s

export MW_K8S_ROOT="$HOME/.mikroways/tools/mw-k8s"
[[ -x $MW_K8S_ROOT/bin/mw-k8s ]] && export PATH="$MW_K8S_ROOT/bin:$PATH" && \
  fpath=($MW_K8S_ROOT/shell-completion/zsh $fpath)

# Enable mw aws profile
export MW_AWS_PROFILE_ROOT="$HOME/.mikroways/tools/mw-aws-profile"
[[ -x $MW_AWS_PROFILE_ROOT/bin/mw-aws-profile ]] && export PATH="$MW_AWS_PROFILE_ROOT/bin:$PATH" && \
  fpath=($MW_AWS_PROFILE_ROOT/shell-completion/zsh $fpath)

# Enable mw sshconfig sync
export MW_SSHCONFIG_SYNC_ROOT="$HOME/.mikroways/tools/mw-sshconfig-sync"
[[ -x $MW_SSHCONFIG_SYNC_ROOT/bin/mw-sshconfig-sync ]] && export PATH="$MW_SSHCONFIG_SYNC_ROOT/bin:$PATH"

# Enable mw gitlab clone
export MW_GITLAB_CLONE="$HOME/.mikroways/tools/mw-gitlab-clone"
[[ -x $MW_GITLAB_CLONE/mw-gitlab-clone ]] && export PATH="$MW_GITLAB_CLONE:$PATH"

# Enable md2pdf
export MW_MD2PDF="$HOME/.mikroways/tools/mw-md2pdf"
[[ -x $MW_MD2PDF/bin/mw-md2pdf ]] && export PATH="$MW_MD2PDF/bin:$PATH"

# Enable grant ssh access
export GRANT_SSH_ACCESS_ROOT="$HOME/.mikroways/tools/mw-grant-ssh-access"
[[ -x $GRANT_SSH_ACCESS_ROOT/bin/mw-grant-ssh-access ]] && export PATH="$GRANT_SSH_ACCESS_ROOT/bin:$PATH"

# Enable mw secrets & bootstrap
export MW_BOOTSTRAP_ROOT="$HOME/.mikroways/tools/mw-bootstrap"
[[ -x $MW_BOOTSTRAP_ROOT/bin/mw-bootstrap ]] && export PATH="$MW_BOOTSTRAP_ROOT/bin:$PATH" && \
  fpath=($MW_BOOTSTRAP_ROOT/shell-completion/zsh $fpath)

# Enable mw skills (Claude Code + gemini-cli)
# Las skills viven en ~/.mikroways/tools/mw-skills/skills/ o en los repos que
# lista su archivo SKILLS, con sparse clones bajo sources/. Si una está en los
# dos lugares es que se está mudando, y gana la de skills/.
_mw_skills_root="$HOME/.mikroways/tools/mw-skills"
if [ -d "$_mw_skills_root" ]; then
  for _mw_skill_dir in "$_mw_skills_root"/sources/*/skills/*/(N) "$_mw_skills_root"/skills/*/(N); do
    # El glob deja un "/" final; readlink nunca lo devuelve, así que se
    # normaliza antes de comparar para no recrear el symlink en cada shell.
    _mw_skill_dir_norm="${_mw_skill_dir%/}"
    _mw_skill_name=$(basename "$_mw_skill_dir")
    if [[ "$_mw_skill_dir" == "$_mw_skills_root"/sources/* && -d "$_mw_skills_root/skills/$_mw_skill_name" ]]; then
      continue
    fi
    _mw_claude_target="$HOME/.claude/skills/$_mw_skill_name"
    # Un directorio real no se pisa: puede ser una skill escrita a mano.
    if [[ -d "$_mw_claude_target" && ! -L "$_mw_claude_target" ]]; then
      :
    elif [[ "$(readlink "$_mw_claude_target" 2>/dev/null)" != "$_mw_skill_dir_norm" ]]; then
      rm -f "$_mw_claude_target"
      ln -s "$_mw_skill_dir_norm" "$_mw_claude_target" 2>/dev/null
    fi
    _mw_gemini_target="$HOME/.gemini/skills/$_mw_skill_name"
    if [[ "$(readlink "$_mw_gemini_target" 2>/dev/null)" != "$_mw_skill_dir_norm" ]] && command -v gemini &>/dev/null; then
      [[ -L "$_mw_gemini_target" ]] && rm -f "$_mw_gemini_target"
      gemini skills link "$_mw_skill_dir_norm" --consent 2>/dev/null
    fi
  done
  unset _mw_skill_dir _mw_skill_dir_norm _mw_skill_name _mw_claude_target _mw_gemini_target
fi
unset _mw_skills_root

# -----------------------------------------------------------------------------
# Enable krew
# -----------------------------------------------------------------------------
KREW_ROOT=$HOME/.krew
[[ -d $KREW_ROOT/bin ]] && export PATH="$KREW_ROOT/bin:$PATH"

# -----------------------------------------------------------------------------
# Autocomplete
# -----------------------------------------------------------------------------
if type aws_completer > /dev/null ; then
  autoload bashcompinit && bashcompinit
  autoload -Uz compinit && compinit
  complete -C 'aws_completer' aws
fi

mkdir -p ~/.zsh/completion
for app in helm velero podman kustomize clusterctl kind eksctl; do
  type $app > /dev/null && \
    [ ! -f ~/.zsh/completion/_$app ] && \
    $app completion zsh > ~/.zsh/completion/_$app
done

type restic > /dev/null && \
  [ ! -f ~/.zsh/completion/_restic ] && \
  restic generate --zsh-completion ~/.zsh/completion/_restic

[[ -f ~/.zshrc.mikroways.user ]] && source ~/.zshrc.mikroways.user
